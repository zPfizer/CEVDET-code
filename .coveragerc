# Kapsam sözleşmesi: hedef %100.
# Dışlama yalnız iki sınıf için meşru: (1) CLI giriş satırı (main() ayrıca
# test edilir), (2) bu platformda fiziksel olarak koşamayan dallar — her biri
# kaynakta gerekçeli "pragma: no cover" taşır.
[run]
source = .codex/scripts, .codex/hooks

[report]
exclude_lines =
    pragma: no cover
    if __name__ == .__main__.:
